{
  "name": "@local/dsh-zhiming",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ZhiMing Feng Shui & Chinese metaphysics studio for DeepSeek Harness (Bazi, Qimen Dunjia, Meihua Yishu, Ziwei Doushu, Hepan).",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "iztro": "^2.5.0",
    "lunar-javascript": "^1.7.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  }
}
